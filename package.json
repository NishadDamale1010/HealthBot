{
  "name": "healthbot-ai",
  "version": "1.0.0",
  "description": "Comprehensive AI Health Assistant with 60+ Advanced Features",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "test": "jest",
    "lint": "eslint backend/src frontend/src",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "keywords": [
    "healthcare",
    "ai",
    "symptom-checker",
    "medical-diagnosis",
    "health-monitoring",
    "telemedicine",
    "wellness",
    "mental-health",
    "emergency-detection"
  ],
  "author": "HealthBot AI Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0",
    "jest": "^29.6.0",
    "eslint": "^8.44.0"
  }
}
